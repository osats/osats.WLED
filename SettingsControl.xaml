<UserControl x:Class="osats.WLED.SettingsControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="WLED · Studio" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Cores, movimento e avisos de telemetria" Opacity="0.7" Margin="0,4"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="Editor"/>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0">
   <WrapPanel>
    <Button Content="Aplicar e guardar" Click="Apply" Padding="16,8" Margin="0,0,8,8"/>
    <Button Content="Parar teste" Click="StopTest" Padding="12,8" Margin="0,0,8,8"/>
    <Button Content="Importar perfil" Click="Import" Padding="12,8" Margin="0,0,8,8"/>
    <Button Content="Exportar perfil" Click="Export" Padding="12,8" Margin="0,0,8,8"/>
    <Button Content="Repor predefinições" Click="Reset" Padding="12,8" Margin="0,0,8,8"/>
   </WrapPanel>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,4"/>
   <TextBlock x:Name="LiveStatus" TextWrapping="Wrap" Opacity="0.7" Margin="0,4"/>
  </StackPanel>
 </Grid>
</UserControl>
